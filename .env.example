# Google Gemini API Key (Required)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Worker URL (Required for Google Vertex AI and AABao API)
# This Worker proxies both Google and AABao requests for better performance
# Google requests: /v1beta/* → Google Vertex AI
# AABao requests: /aabao/v1beta/* → AABao API
CLOUDFLARE_WORKER_URL=https://nano.mygogogo1.de5.net

# AABao API Configuration (Optional - only needed if using AABao image generation provider)
# For VIP keys (sk- prefix), use: https://api.aabao.top
# For standard keys, use: https://api.aabao.vip
# Note: API key is configured in the Cloudflare Worker, not here
AABAO_API_KEY=your_aabao_api_key_here
AABAO_API_BASE=https://api.aabao.vip

# OpenAI API Key (Optional - only needed if using OpenAI LLM provider)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# MySQL Database Configuration (Required for authentication)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=node_banana

# JWT Configuration (Required for authentication)
JWT_SECRET=your-random-secret-key-change-in-production
JWT_EXPIRES_IN=7d
