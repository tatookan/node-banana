# Google Gemini API Key (Required)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Worker URL (Required for Google Vertex AI and AABao API)
# This Worker proxies both Google and AABao requests for better performance
# Google requests: /v1beta/* → Google Vertex AI
# AABao requests: /aabao/v1beta/* → AABao API
CLOUDFLARE_WORKER_URL=https://nano.mygogogo1.de5.net

# AABao API Configuration (Required for AABao image generation provider)
# Available endpoints:
#   - https://api.aabao.top (Direct connection - bypasses Cloudflare Worker timeout)
#   - https://cf-api.aabao.top (CloudFlare accelerated - subject to 100s timeout)
#   - https://hk-api.aabao.top (Hong Kong accelerated)
# For direct connection (bypassing 100s timeout): use https://api.aabao.top
AABAO_API_KEY=sk-gXWNhcbbXQAXs3AYAOjNQteCMatrTWNDsXwgTyKGWFQFzHls
AABAO_API_BASE=https://api.aabao.top

# OpenAI API Key (Optional - only needed if using OpenAI LLM provider)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# MySQL Database Configuration (Required for authentication)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=node_banana

# JWT Configuration (Required for authentication)
JWT_SECRET=your-random-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Cloudflare R2 Storage Configuration (Required for image storage)
# Get your credentials from: https://dash.cloudflare.com/ > R2 > Overview
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=bananan

# ===== Worker R2 Binding (Paid Plan Feature) =====
# For optimal performance, configure R2 binding directly in Cloudflare Worker:
# 1. Upgrade to Workers Paid Plan ($5/month)
# 2. Go to: Workers & Pages > nano.mygogogo1.de5.net > Settings > Variables
# 3. Add "R2 Bucket" binding:
#    - Variable name: R2_BUCKET
#    - Bucket name: bananan
# This allows Worker to parse JSON and upload to R2 directly (50% faster!)
